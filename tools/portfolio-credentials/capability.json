{
  "schemaVersion": 1,
  "provider": "cloudflare",
  "capability": "pages-direct-upload",
  "repository": {
    "remoteName": "origin",
    "remoteUrl": "https://github.com/pedro-rtm/valepath-website.git",
    "branch": "main"
  },
  "credential": {
    "keychainService": "com.pedrortm.valepath-website.cloudflare.pages-deploy",
    "keychainAccount": "api-token",
    "onePasswordItem": "Valepath Website Cloudflare Pages Deploy"
  },
  "build": {
    "mode": "command",
    "outputDirectory": "dist"
  },
  "cloudflare": {
    "accountId": "82675093f8de0440782f81032b6a33d1",
    "pagesProject": "valepath-website",
    "pagesProjectId": "691c1c43-cfe0-443b-830d-8abeb8e81462",
    "productionBranch": "main"
  },
  "limits": {
    "commandTimeoutSeconds": 900,
    "apiTimeoutSeconds": 30,
    "deploymentTimeoutSeconds": 600,
    "minimumTokenLifetimeSeconds": 2592000,
    "maxArtifactFiles": 20000,
    "maxArtifactFileBytes": 26214400,
    "maxArtifactTotalBytes": 1073741824
  }
}
