---
import '../styles/main.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string | null;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, ogImage = '/og-image.png', jsonLd } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = ogImage ? new URL(ogImage, Astro.site).href : null;
const additionalJsonLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Valepath',
  url: 'https://valepath.com',
  slogan: 'Assess. Deploy. Transfer.',
  foundingDate: '2013',
  description:
    'A technology transformation practice that assesses technology, deploys the fix, and transfers durable capability across enterprise systems, infrastructure, data, automation, AI, and technology due diligence.',
  logo: 'https://valepath.com/og-image.png',
  founder: {
    '@type': 'Person',
    name: 'Pedro Rivera Torres Moir',
    jobTitle: 'Founder & Principal',
    url: 'https://pedrortm.com',
    sameAs: ['https://linkedin.com/in/pedrortm', 'https://pedrortm.com'],
  },
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Europe' },
    { '@type': 'AdministrativeArea', name: 'North America' },
  ],
  serviceType: [
    'Technology assessment',
    'Technology transformation',
    'Technology due diligence',
    'Enterprise systems implementation',
    'Data and automation transformation',
  ],
  knowsAbout: [
    'ERP',
    'CRM',
    'enterprise systems',
    'technology infrastructure',
    'IoT',
    'business intelligence',
    'data platforms',
    'workflow automation',
    'artificial intelligence',
    'technology due diligence',
    'operating-model transformation',
  ],
  sameAs: ['https://linkedin.com/in/pedrortm', 'https://pedrortm.com'],
};

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Pedro Rivera Torres Moir',
  url: 'https://pedrortm.com',
  jobTitle: 'Founder & Principal',
  worksFor: {
    '@type': 'Organization',
    name: 'Valepath',
    url: 'https://valepath.com',
  },
  sameAs: ['https://linkedin.com/in/pedrortm', 'https://pedrortm.com'],
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#faf8f5" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  {ogImageURL && <meta property="og:image" content={ogImageURL} />}
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="Valepath" />
  <meta property="og:locale" content="en_GB" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  {ogImageURL && <meta name="twitter:image" content={ogImageURL} />}

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif&family=Space+Grotesk:wght@300;400;500;600&display=swap" rel="stylesheet" />

  <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
  {additionalJsonLd.map((item) => (
    <script type="application/ld+json" set:html={JSON.stringify(item)} />
  ))}
</head>
<body>
  <slot />
</body>
</html>
