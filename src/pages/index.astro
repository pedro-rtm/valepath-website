---
import Base from '../layouts/Base.astro';
import CompanyCard from '../components/CompanyCard.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { featuredCompanies } from '../data/companies';
import { testimonials } from '../data/testimonials';

const capabilities = [
  {
    title: 'ERP & finance systems',
    description: 'Selection, implementation, integration, and operating discipline across core transaction systems.',
  },
  {
    title: 'CRM & commercial operations',
    description: 'Pipeline, quoting, customer service, and revenue workflows designed around how teams actually sell.',
  },
  {
    title: 'Enterprise systems',
    description: 'HRIS, collaboration, identity, service management, and the connective tissue between functions.',
  },
  {
    title: 'Infrastructure & security',
    description: 'Networks, cloud, resilience, identity, physical security, and the controls required to operate safely.',
  },
  {
    title: 'IoT & operational technology',
    description: 'Sensors, telemetry, PLC automation, geospatial systems, and predictive maintenance in the physical estate.',
  },
  {
    title: 'BI, data & decision systems',
    description: 'Trusted metrics, integrated data flows, dashboards, and decision cadences that change management behaviour.',
  },
  {
    title: 'Automation & process redesign',
    description: 'Workflow simplification first; automation second. Less reconciliation, faster cycle times, clearer ownership.',
  },
  {
    title: 'AI & proprietary technology',
    description: 'AI readiness, deployment, model and data risk, agentic workflows, and durable product advantage.',
  },
  {
    title: 'Operating-model transformation',
    description: 'Team design, governance, vendor structure, capability transfer, and a system the internal organisation can own.',
  },
];

const ddDimensions = [
  'Architecture & infrastructure',
  'Team & organisation',
  'Security & compliance',
  'Data & analytics',
  'AI & proprietary technology',
  'Cost structure',
  'Delivery capability',
  'Strategic alignment & bolt-on readiness',
];
---

<Base
  title="Valepath — Technology Transformation, 2013–Present"
  description="Valepath assesses technology, deploys the fix, and transfers durable capability across enterprise systems, infrastructure, data, automation, AI, and technology due diligence."
>
  <div class="page">
    <SiteHeader />

    <main>
      <section class="hero">
        <p class="hero__eyebrow">Technology transformation &middot; 2013&ndash;present</p>
        <h1>Assess. Deploy. Transfer.</h1>
        <p class="hero__lead">
          Valepath enters when technology is material to the outcome: before an acquisition, during a transformation, or when systems no longer serve the business. We diagnose the estate, build the fix, and leave the organisation able to run it.
        </p>
        <div class="hero__offer">
          ERP &middot; CRM &middot; enterprise systems &middot; infrastructure &middot; IoT &middot; BI &amp; data &middot; automation &middot; AI &middot; technology due diligence
        </div>
        <div class="hero__ctas">
          <a href="/case-studies/" class="btn">See the transformation record &rarr;</a>
          <a href="#contact" class="btn btn--secondary">Discuss an engagement</a>
        </div>
      </section>

      <section class="proof-strip" aria-label="Valepath track record">
        <div class="proof-stat">
          <span class="proof-stat__value">2013&ndash;present</span>
          <span class="proof-stat__label">Continuous practice</span>
        </div>
        <div class="proof-stat">
          <span class="proof-stat__value">80+</span>
          <span class="proof-stat__label">Initiatives</span>
        </div>
        <div class="proof-stat">
          <span class="proof-stat__value">9</span>
          <span class="proof-stat__label">Industries</span>
        </div>
        <div class="proof-stat">
          <span class="proof-stat__value">$5M&ndash;$300M+</span>
          <span class="proof-stat__label">Company revenue</span>
        </div>
      </section>

      <section class="section section--alt" id="engagements">
        <p class="section-kicker">Engagements</p>
        <h2>One practice, three modes.</h2>
        <p class="section-lead">
          The work can stop at a decision, continue through implementation, or carry through to a self-sufficient internal team. Scope follows the outcome, not a fixed consulting package.
        </p>

        <div class="mode-grid">
          <article class="mode-card">
            <span class="mode-card__number">01</span>
            <h3>Assess</h3>
            <p>Establish what is true, what is material, and what it will cost to change.</p>
            <ul>
              <li>Enterprise technology assessment</li>
              <li>Technology due diligence</li>
              <li>Architecture, security, data, and AI risk</li>
              <li>Cost-to-fix and value-creation roadmap</li>
            </ul>
          </article>
          <article class="mode-card mode-card--featured">
            <span class="mode-card__number">02</span>
            <h3>Deploy</h3>
            <p>Build the operating change, not merely the recommendation.</p>
            <ul>
              <li>ERP, CRM, and enterprise systems</li>
              <li>Infrastructure, IoT, and operational technology</li>
              <li>BI, data, workflow automation, and AI</li>
              <li>Programme leadership and benefits realisation</li>
            </ul>
          </article>
          <article class="mode-card">
            <span class="mode-card__number">03</span>
            <h3>Transfer</h3>
            <p>Make the new capability durable inside the organisation.</p>
            <ul>
              <li>Operating model and governance</li>
              <li>Team, vendor, and ownership design</li>
              <li>Documentation, training, and handover</li>
              <li>Metrics and management cadence</li>
            </ul>
          </article>
        </div>
      </section>

      <section class="section" id="capabilities">
        <p class="section-kicker">Capabilities</p>
        <h2>Technology in the service of operations.</h2>
        <p class="section-lead">
          The practice spans the full enterprise estate. AI is now an important layer within that estate; it does not replace the systems, data, process, and operating discipline beneath it.
        </p>
        <div class="capability-grid">
          {capabilities.map((capability, index) => (
            <article class="capability-card">
              <span class="capability-card__index">{String(index + 1).padStart(2, '0')}</span>
              <h3>{capability.title}</h3>
              <p>{capability.description}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="section section--alt" id="method">
        <p class="section-kicker">Method</p>
        <h2>The recommendation and the implementation remain connected.</h2>
        <div class="method-flow">
          <article>
            <span>Assess</span>
            <h3>Find the constraint</h3>
            <p>Interviews, system and data review, frontline observation, risk ranking, economics, and a decision-ready baseline.</p>
          </article>
          <div class="method-flow__arrow" aria-hidden="true">&rarr;</div>
          <article>
            <span>Deploy</span>
            <h3>Change the system</h3>
            <p>A sequenced programme with named owners, measurable outcomes, controlled dependencies, and working technology.</p>
          </article>
          <div class="method-flow__arrow" aria-hidden="true">&rarr;</div>
          <article>
            <span>Transfer</span>
            <h3>Leave capability behind</h3>
            <p>Internal ownership, operating cadence, documentation, training, and evidence that the result survives the engagement.</p>
          </article>
        </div>
      </section>

      <section class="section" id="track-record">
        <div class="section-heading-row">
          <div>
            <p class="section-kicker">Transformation record</p>
            <h2>Substantive work, not capability theatre.</h2>
          </div>
          <a href="/case-studies/" class="text-link">All 9 case studies &rarr;</a>
        </div>
        <p class="section-lead">
          Selected company-wide transformations across hospitality, construction, real estate, education, utilities, smart communities, and public services.
        </p>
        <div class="featured-cases">
          {featuredCompanies.map((company) => <CompanyCard company={company} />)}
        </div>
        <div class="outcome-grid">
          <div class="outcome">
            <span class="outcome__metric">+18% NOI</span>
            <span>Resort transformation spanning systems, operations, people, and guest experience.</span>
          </div>
          <div class="outcome">
            <span class="outcome__metric">0 hours</span>
            <span>Unplanned downtime after industrial PLC and monitoring automation.</span>
          </div>
          <div class="outcome">
            <span class="outcome__metric">&minus;75%</span>
            <span>Data synchronisation and reporting time after PMS/ERP integration.</span>
          </div>
          <div class="outcome">
            <span class="outcome__metric">99.8%</span>
            <span>Network uptime across a distributed operating estate.</span>
          </div>
        </div>
      </section>

      <section class="section section--alt" id="due-diligence">
        <div class="dd-grid">
          <div>
            <p class="section-kicker">One engagement type</p>
            <h2>Technology due diligence.</h2>
            <p class="section-lead">
              When the decision is an acquisition, Valepath converts technical findings into investment consequences: quantified risk, phased cost-to-fix, first-100-day priorities, and deal-structuring implications.
            </p>
            <div class="hero__ctas">
              <a href="/sample-dd-report.pdf" class="btn" download>Download sample report &darr;</a>
              <a href="#contact" class="btn btn--secondary">Discuss a transaction</a>
            </div>
          </div>
          <ol class="dimension-list">
            {ddDimensions.map((dimension, index) => (
              <li><span>{index + 1}</span>{dimension}</li>
            ))}
          </ol>
        </div>
      </section>

      <section class="section" id="references">
        <p class="section-kicker">Operator references</p>
        <h2>Trusted at the point of execution.</h2>
        <div class="testimonials">
          {testimonials.map((testimonial) => (
            <blockquote class="testimonial">
              <p>&ldquo;{testimonial.quote}&rdquo;</p>
              <cite>{testimonial.name} &middot; {testimonial.title}</cite>
            </blockquote>
          ))}
        </div>
      </section>

      <section class="section section--alt" id="about">
        <p class="section-kicker">About</p>
        <div class="about-grid">
          <div>
            <h2>A continuous transformation practice.</h2>
            <p>
              Valepath is the practice through which Pedro Rivera Torres Moir has assessed, built, and transferred technology-led operating change since 2013. Its record spans 80+ initiatives across nine industries and companies ranging from $5M to $300M+ in annual revenue.
            </p>
            <p>
              Engagements are defined by a material operating outcome. The practice combines executive accountability with enough technical depth to move from board-level decision to deployed system without losing the thread between them.
            </p>
          </div>
          <div>
            <h3>Pedro Rivera Torres Moir</h3>
            <p>
              Founder &amp; Principal. Technology operator across enterprise systems, infrastructure, data, AI, and company-wide transformation. B.S. Electrical &amp; Computer Engineering, University of Colorado Boulder; Advanced Project Management, Stanford. Based in Madrid, working across Europe and North America. EU, US, and Mexico citizen.
            </p>
            <a href="https://pedrortm.com" target="_blank" rel="noopener" class="text-link">Full profile at pedrortm.com &rarr;</a>
          </div>
        </div>
      </section>

      <section class="section" id="contact">
        <p class="section-kicker">Contact</p>
        <h2>Bring the operating problem.</h2>
        <p class="section-lead">
          For a technology assessment, a transformation that must reach production, or a transaction where the technology thesis needs to be quantified. A brief description of the organisation, the decision, and the timeline is sufficient to begin.
        </p>
        <div class="contact-block">
          <button
            type="button"
            class="contact-email"
            aria-label="Copy Valepath contact email to clipboard"
          >
            <span class="contact-email__default">Copy email</span>
            <span class="contact-email__done" aria-hidden="true">Copied &check;</span>
          </button>
        </div>
        <div class="contact-row">
          <a href="https://linkedin.com/in/pedrortm" target="_blank" rel="noopener">LinkedIn</a>
          <a href="https://pedrortm.com" target="_blank" rel="noopener">pedrortm.com</a>
        </div>
      </section>
    </main>

    <SiteFooter />
  </div>

  <script is:inline>
    document.querySelectorAll('.contact-email').forEach((button) => {
      button.addEventListener('click', async () => {
        const local = [111, 114, 100, 101, 112].reverse();
        const domain = [109, 111, 99, 46, 104, 116, 97, 112, 101, 108, 97, 118].reverse();
        const email = String.fromCharCode(...local, 64, ...domain);
        try {
          await navigator.clipboard.writeText(email);
        } catch {
          const textArea = document.createElement('textarea');
          textArea.value = email;
          textArea.setAttribute('readonly', '');
          textArea.style.position = 'absolute';
          textArea.style.left = '-9999px';
          document.body.appendChild(textArea);
          textArea.select();
          document.execCommand('copy');
          textArea.remove();
        }
        button.classList.add('is-copied');
        window.setTimeout(() => button.classList.remove('is-copied'), 1800);
      });
    });
  </script>
</Base>
